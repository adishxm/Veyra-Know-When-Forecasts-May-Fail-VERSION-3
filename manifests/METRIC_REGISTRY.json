{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "registry_name": "VEYRA_SENTINEL_METRIC_REGISTRY",
  "version": "2.0.0",
  "generated_date": "2026-09-29",
  "governance_authority": "VEYRA_COMPLETE_PHASE_BY_PHASE_EXECUTION_MANUAL_V2.md",
  "metrics": {
    "brier_score": {
      "metric_id": "MET-001",
      "name": "Brier Score",
      "mathematical_definition": "BS = (1/N) * sum_{i=1}^N (p_i - y_i)^2",
      "direction": "LOWER_IS_BETTER",
      "range": [0.0, 1.0],
      "role": "PRIMARY",
      "ci_method": "BLOCK_BOOTSTRAP_CYCLE_AWARE",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 1000,
      "minimum_positive_count": 50,
      "aggregation": "MEAN_SQUARED_ERROR",
      "subgroup_policy": "REPORT_PER_LEAD_PER_STATION_PER_HAZARD",
      "reference_baseline": "SAMPLE_CLIMATOLOGY"
    },
    "brier_skill_score": {
      "metric_id": "MET-002",
      "name": "Brier Skill Score",
      "mathematical_definition": "BSS = 1 - (BS_model / BS_climatology)",
      "direction": "HIGHER_IS_BETTER",
      "range": [-Infinity, 1.0],
      "role": "PRIMARY",
      "ci_method": "PERCENTILE_BOOTSTRAP_PAIRED",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 1000,
      "minimum_positive_count": 50,
      "aggregation": "SKILL_SCORE_RELATIVE_TO_CLIMATOLOGY",
      "subgroup_policy": "MUST_EXCEED_ZERO_IN_CERTIFIED_REGIMES",
      "reference_baseline": "FROZEN_CLIMATOLOGY_PREVALENCE"
    },
    "roc_auc": {
      "metric_id": "MET-003",
      "name": "Receiver Operating Characteristic Area Under Curve",
      "mathematical_definition": "ROC-AUC = P(p_positive > p_negative) via Mann-Whitney U",
      "direction": "HIGHER_IS_BETTER",
      "range": [0.0, 1.0],
      "role": "SECONDARY",
      "ci_method": "DELONG_OR_STRATIFIED_BOOTSTRAP",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 500,
      "minimum_positive_count": 25,
      "aggregation": "RANK_CORRELATION",
      "subgroup_policy": "REPORT_ONLY_WHEN_BOTH_CLASSES_PRESENT",
      "reference_baseline": "0.50_NO_DISCRIMINATION"
    },
    "pr_auc": {
      "metric_id": "MET-004",
      "name": "Precision-Recall Area Under Curve (Average Precision)",
      "mathematical_definition": "PR-AUC = sum_k (R_k - R_{k-1}) * P_k",
      "direction": "HIGHER_IS_BETTER",
      "range": [0.0, 1.0],
      "role": "PRIMARY_IMBALANCED",
      "ci_method": "LOGIT_TRANSFORMED_BOOTSTRAP",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 500,
      "minimum_positive_count": 25,
      "aggregation": "WEIGHTED_TRAPEZOIDAL_SUM",
      "subgroup_policy": "MUST_EXCEED_SAMPLE_PREVALENCE_CLIMATOLOGY",
      "reference_baseline": "POSITIVE_PREVALENCE_BASE_RATE"
    },
    "expected_calibration_error": {
      "metric_id": "MET-005",
      "name": "Expected Calibration Error (ECE)",
      "mathematical_definition": "ECE = sum_{b=1}^B (|B_b| / N) * |acc(B_b) - conf(B_b)|",
      "direction": "LOWER_IS_BETTER",
      "range": [0.0, 1.0],
      "role": "PRIMARY_UNCERTAINTY",
      "ci_method": "RESAMPLED_BIN_PERCENTILE",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 1000,
      "minimum_positive_count": 50,
      "bins_count": 10,
      "aggregation": "WEIGHTED_ABSOLUTE_DIFFERENCE",
      "subgroup_policy": "REPORT_PER_STATION_AND_LEAD",
      "reference_baseline": "UNIFORM_CALIBRATION_ZERO_ERROR"
    },
    "log_loss": {
      "metric_id": "MET-006",
      "name": "Binary Cross-Entropy Loss (Log Loss)",
      "mathematical_definition": "LogLoss = -(1/N) * sum_{i=1}^N [y_i * log(p_i) + (1 - y_i) * log(1 - p_i)]",
      "direction": "LOWER_IS_BETTER",
      "range": [0.0, Infinity],
      "role": "SECONDARY",
      "ci_method": "BLOCK_BOOTSTRAP",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 1000,
      "minimum_positive_count": 50,
      "aggregation": "NEGATIVE_LOG_LIKELIHOOD",
      "subgroup_policy": "CLIPPED_PROBABILITIES_EPSILON_1E_15",
      "reference_baseline": "ENTROPY_OF_CLIMATOLOGY"
    },
    "false_alarm_rate": {
      "metric_id": "MET-007",
      "name": "False Alarm Rate (False Positive Rate)",
      "mathematical_definition": "FAR = FP / (FP + TN)",
      "direction": "LOWER_IS_BETTER",
      "range": [0.0, 1.0],
      "role": "OPERATIONAL_SAFETY",
      "ci_method": "WILSON_SCORE_INTERVAL",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 500,
      "minimum_positive_count": 25,
      "aggregation": "BINARY_CONFUSION_FRACTION",
      "subgroup_policy": "EVALUATED_AT_OPERATIONAL_THRESHOLD_0_06",
      "reference_baseline": "UNFILTERED_RAW_RATE"
    },
    "miss_rate": {
      "metric_id": "MET-008",
      "name": "Miss Rate (False Negative Rate)",
      "mathematical_definition": "MissRate = FN / (TP + FN) = 1 - Recall",
      "direction": "LOWER_IS_BETTER",
      "range": [0.0, 1.0],
      "role": "OPERATIONAL_SAFETY",
      "ci_method": "WILSON_SCORE_INTERVAL",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 500,
      "minimum_positive_count": 25,
      "aggregation": "BINARY_CONFUSION_FRACTION",
      "subgroup_policy": "EVALUATED_AT_OPERATIONAL_THRESHOLD_0_06",
      "reference_baseline": "CLIMATOLOGICAL_MISS_RATE"
    },
    "risk_coverage_tradeoff": {
      "metric_id": "MET-009",
      "name": "Selective Risk-Coverage Ratio",
      "mathematical_definition": "DeltaBS_pct = ((BS_unfiltered - BS_retained) / BS_unfiltered) * 100",
      "direction": "HIGHER_IS_BETTER",
      "range": [-Infinity, 100.0],
      "role": "SELECTIVE_CLASSIFICATION",
      "ci_method": "EMPIRICAL_RISK_CURVE",
      "bootstrap_replications": 1000,
      "minimum_sample_count": 1000,
      "minimum_positive_count": 50,
      "aggregation": "RETAINED_ERROR_REDUCTION_OVER_COVERAGE",
      "subgroup_policy": "MUST_SHOW_STRICTLY_LOWER_BRIER_SCORE_ON_RETAINED_POPULATION",
      "reference_baseline": "100_PCT_FORCED_COVERAGE"
    }
  }
}
